@echo off
setlocal enabledelayedexpansion
REM Flash ESP32-S3 MicroPython firmware.
REM
REM If a .\flash_args.txt is present (generated by CI), it will be used and should
REM contain lines like:
REM   0x0 base_firmware.bin
REM   0x2D0000 vfs.bin
REM
REM Otherwise, this script falls back to flashing a lvgl_micropython merged image
REM at 0x0 (or base_firmware.bin if present).

echo Flashing ESP32-S3 firmware...
echo Make sure your ESP32-S3 is connected and in download mode
echo.

REM Check if Python and esptool are available
where python >nul 2>&1
if %errorlevel% neq 0 (
    echo Error: Python not found in PATH.
    pause
    exit /b 1
)
python -m esptool version >nul 2>&1
if %errorlevel% neq 0 (
    echo Error: esptool not found. Please install with: python -m pip install esptool
    pause
    exit /b 1
)

set "FLASH_ARGS="
set "FLASH_ARGS_FILE="

if exist "flash_args.txt" (
    set "FLASH_ARGS_FILE=flash_args.txt"
)

if not "%FLASH_ARGS_FILE%"=="" (
    echo Using flash args file: %FLASH_ARGS_FILE%
    for /f "usebackq tokens=1,2" %%A in (`type "%FLASH_ARGS_FILE%" ^| findstr /r /v "^[ ]*$" ^| findstr /v /b "#"`) do (
        set "FLASH_FILE=%%B"
        if not exist "!FLASH_FILE!" (
            echo Error: '%%B' referenced in %FLASH_ARGS_FILE% but not found
            pause
            exit /b 1
        )
        if not exist "!FLASH_FILE!" (
            echo Error: '!FLASH_FILE!' referenced in %FLASH_ARGS_FILE% but not found
            pause
            exit /b 1
        )
        set "FLASH_ARGS=!FLASH_ARGS! %%A !FLASH_FILE!"
    )
) else (
    REM Find a base firmware image to flash at 0x0
    if exist "base_firmware.bin" (
        set "FIRMWARE_BIN=base_firmware.bin"
        echo Found firmware: !FIRMWARE_BIN!
    ) else (
        set "count=0"
        for %%f in (lvgl_micropy_ESP32_GENERIC_S3-*.bin) do (
            set /a count+=1
            set "firmware[!count!]=%%f"
        )

        if !count! equ 0 (
            echo Error: No firmware binary found (base_firmware.bin or lvgl_micropy_ESP32_GENERIC_S3-*.bin)
            pause
            exit /b 1
        ) else if !count! equ 1 (
            set "FIRMWARE_BIN=!firmware[1]!"
            echo Found firmware: !FIRMWARE_BIN!
        ) else (
            echo Multiple firmware binaries found. Please select one:
            for /l %%i in (1,1,!count!) do (
                echo %%i. !firmware[%%i]!
            )
            echo.
            setlocal disabledelayedexpansion
            set /p choice="Enter your choice (1-!count!): "
            setlocal enabledelayedexpansion

            if not defined firmware[!choice!] (
                echo Invalid selection: !choice!
                pause
                exit /b 1
            )

            for %%i in (!choice!) do set "FIRMWARE_BIN=!firmware[%%i]!"
            echo Selected: !FIRMWARE_BIN!
        )
    )

    if not exist "!FIRMWARE_BIN!" (
        echo Error: !FIRMWARE_BIN! not found
        pause
        exit /b 1
    )

    set "FLASH_ARGS=0x0 !FIRMWARE_BIN!"
)

REM Set default port if not specified
if "%PORT%"=="" (
    echo Auto-detecting port...
    REM Try common Windows COM ports
    for %%p in (COM3 COM4 COM5 COM6 COM7 COM8 COM9 COM10) do (
        mode %%p >nul 2>&1
        if !errorlevel! equ 0 (
            set PORT=%%p
            goto :found_port
        )
    )
    
    echo Could not auto-detect port. Please set PORT environment variable.
    echo Example: set PORT=COM3 ^&^& %0
    pause
    exit /b 1
)

:found_port
echo Using port: %PORT%
echo.

REM Erase flash first (recommended for clean install). Set ERASE_FIRST=0 to skip.
if "%ERASE_FIRST%"=="0" (
    echo Skipping erase ^(ERASE_FIRST=0^)
) else (
    echo Erasing flash...
    python -m esptool --chip esp32s3 --port %PORT% erase_flash

    if %errorlevel% neq 0 (
        echo Error: Failed to erase flash
        pause
        exit /b 1
    )
)

echo.
echo Flashing firmware images...

python -m esptool --chip esp32s3 ^
    --port %PORT% ^
    --baud 460800 ^
    write_flash ^
    --compress ^
    !FLASH_ARGS!

if %errorlevel% equ 0 (
    echo.
    echo Flash completed successfully.
    echo.
    echo Your ESP32-S3 is now ready. You can:
    echo 1. Reset the device
    echo 2. Connect via serial terminal (115200 baud^)
    echo 3. Upload your Python files to the device
) else (
    echo.
    echo Flash failed!
    pause
    exit /b 1
)

pause
